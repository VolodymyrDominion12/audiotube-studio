# Скопіюйте у .env і заповніть лише те, що використовуєте.
# .env читається автоматично і не перекриває змінні, вже задані в оточенні.
# Файл у .gitignore — не комітьте ключі.

# LLM
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# Для Ollama ключ не потрібен (працює локально на 127.0.0.1:11434).

# Хмарна транскрипція (якщо transcribe.backend: openai або auto без faster-whisper)
# OPENAI_API_KEY=sk-...

# Майбутні джерела фонів (Pexels / Pixabay) — поки не використовуються
# PEXELS_API_KEY=...
# PIXABAY_API_KEY=...
